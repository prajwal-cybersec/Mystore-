PG_URL=postgres://user:password@localhost:5432/nammastore?sslmode=require
OPENSEARCH_URL=https://user:password@localhost:9200
# OpenSearch TLS (OPENSEARCH_VERIFY_CERTS may be set to false for local development only)
OPENSEARCH_CA=
OPENSEARCH_VERIFY_CERTS=true
KAFKA_BROKER=localhost:9092
KAFKA_CA=certs/ca.pem
KAFKA_USER=kafka_user
KAFKA_PASSWORD=kafka_password
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
LLM_FALLBACK_ENABLED=false
APP_ENV=development
LOG_LEVEL=INFO
ADMIN_API_KEY=admin-secret-key-change-in-production
